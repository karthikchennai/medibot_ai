# Groq is the optional fallback provider. Keep real credentials in .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Leave QDRANT_URL blank for persistent embedded Qdrant (one backend process).
QDRANT_URL=
QDRANT_API_KEY=
# Optional: set a random secret of 32+ characters. A local secret is generated otherwise.
JWT_SECRET=
# Optional: explicit YYYY-MM-DD reference date for relative-date SQL demonstrations.
REFERENCE_DATE=

# Login accounts: fill both values to enable a role; leave both blank to disable.
# Use unique usernames. Restart the backend after changes.
DOCTOR_USERNAME=
DOCTOR_PASSWORD=
NURSE_USERNAME=
NURSE_PASSWORD=
BILLING_EXECUTIVE_USERNAME=
BILLING_EXECUTIVE_PASSWORD=
TECHNICIAN_USERNAME=
TECHNICIAN_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Primary: project Bedrock gateway (Azure AD client-credentials authentication).
TENANT_ID=
AI_CLIENT_ID=
AI_CLIENT_SECRET=
MODEL_SERVING_SCOPE=
BEDROCK_API_URL=
# Optional custom trusted CA PEM; leave blank for the OS certificate store.
SSL_CA_BUNDLE=
BEDROCK_TIMEOUT_SECONDS=45
BEDROCK_AUTH_TIMEOUT_SECONDS=15
# False disables all automatic calls to Groq.
GROQ_FALLBACK_ENABLED=true
